{
  "appId": "com.fledgetone.pocket",
  "appName": "Fledgetone",
  "webDir": "dist-app",
  "backgroundColor": "#0b0f14",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
