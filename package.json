{
  "name": "fledgetone",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "2026.10.16-10",
  "type": "module",
  "scripts": {
    "dev": "npm run build:runtime && vite",
    "build": "npm run build:runtime && tsc -b && vite build",
    "build:runtime": "vite build -c vite.runtime.config.ts",
    "lint": "oxlint",
    "test": "node --test scripts/*.test.mjs",
    "codemap": "node scripts/codemap.mjs",
    "guide-tables": "node scripts/guide-tables.mjs",
    "preview": "vite preview",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "build:site": "npm run build -- --base=/app/ --outDir=dist-site/app && node scripts/build-site.mjs",
    "build:full": "VITE_GPL_PLUGINS=1 npm run build && VITE_GPL_PLUGINS=1 node scripts/build-single.mjs"
  },
  "dependencies": {
    "@webaudiomodules/api": "^2.0.0-alpha.6",
    "@webaudiomodules/sdk": "^0.0.12",
    "lucide-react": "^1.52.0",
    "mediabunny": "^1.61.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.170.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0",
    "wasm-media-encoders": "^0.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
